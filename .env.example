# Copy this file to .env and fill it in. Never share .env.
PORT=3000
DB_PATH=./data/strike.db

# ---- DEMO PAGE ----
# The default demo uses Puter.js (AI + voice run in the visitor's browser, no keys needed here).
# Everything below is OPTIONAL and only used if you open the link with &engine=server.
# Free key from console.groq.com -> API Keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ---- EXOTEL PHONE LINE (leave all of these blank for now) ----
# PUBLIC_BASE_URL=https://your-app.up.railway.app
# EXOTEL_ACCOUNT_SID=
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=
# EXOTEL_API_HOST=api.in.exotel.com
# EXOTEL_CALLER_ID=+918012345678
# EXOTEL_WS_USER=exotel
# EXOTEL_WS_PASSWORD=

# ---- NATURAL VOICE, FREE OPTION: Google Cloud Text-to-Speech ----
# TTS_PROVIDER=google
# GOOGLE_TTS_API_KEY=
# Defaults are Chirp 3 HD voices (most natural). If a name is rejected or not free for you, try
# en-IN-Neural2-A / hi-IN-Neural2-A (female) or en-IN-Neural2-B / hi-IN-Neural2-B (male).
# GOOGLE_VOICE_EN=en-IN-Chirp3-HD-Aoede
# GOOGLE_VOICE_HI=hi-IN-Chirp3-HD-Aoede

# ---- NATURAL VOICE, PAID OPTION: ElevenLabs (use this OR Google) ----
# Leave TTS_PROVIDER out to use the free built-in voice
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# eleven_flash_v2_5 = fastest. eleven_v3 = most expressive/human, slower to start talking.
# ELEVENLABS_MODEL=eleven_flash_v2_5
# Voice IDs from elevenlabs.io -> Voices (pick a Hindi-capable voice for HI)
# ELEVENLABS_VOICE_EN=
# ELEVENLABS_VOICE_HI=

# ---- WHATSAPP AGENT via KAPSO ----
# Needs: the live Railway deploy, plus GROQ_API_KEY above (for the AI replies).
# To use: remove the "# " at the start of a line and fill in the value. Keep each value on its own line with nothing after it.

# Kapso dashboard -> Integrations -> API keys -> create a new key
# KAPSO_API_KEY=
# Kapso dashboard -> Phone numbers -> Phone number ID column. 597907523413541 is the Sandbox number; 1446197948568307 is the +1 711 number (needs its payment issue fixed first).
# KAPSO_PHONE_NUMBER_ID=597907523413541
# Make up 16+ random characters. The register command gives the same text to Kapso.
# KAPSO_WEBHOOK_SECRET=
# Your live https address, no slash at the end
# PUBLIC_BASE_URL=https://your-app.up.railway.app
# BUSINESS_NAME=Skyline Realty
# The agent's own WhatsApp number: country code first, digits only
# AGENT_PHONE=919876543210
# DAILY_REPORT_TIME=20:00
# REPORT_TZ=Asia/Kolkata
# true = answer voice notes with voice notes (also needs TTS_PROVIDER=google and GOOGLE_TTS_API_KEY)
# WA_VOICE_REPLIES=false
# Make up 12+ random characters. Opens the live dashboard at /demo/dashboard?token=THAT-TEXT
# DASHBOARD_TOKEN=

# Railway only: add a Volume mounted at /data and set DB_PATH=/data/strike.db, or chats are lost on every redeploy.
